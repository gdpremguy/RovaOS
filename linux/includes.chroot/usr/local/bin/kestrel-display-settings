#!/usr/bin/python3
"""Native Niri scale controls. Own generated include, never rewrite user config."""
import json
import pathlib
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib


class Displays(Gtk.Window):
    def __init__(self):
        super().__init__(title='Rova Display Settings')
        self.set_default_size(760, 480)
        self.connect('destroy', Gtk.main_quit)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin=24)
        self.add(box)
        box.pack_start(Gtk.Label(label='Display scaling · native Wayland', xalign=0), False, False, 0)
        self.rows = []
        self.previous = None
        self.countdown = 0
        self.timer = None
        self.connect('delete-event', self.closing)
        self.outputs = outputs = json.loads(subprocess.check_output(['niri', 'msg', '--json', 'outputs'], text=True))
        for name, output in outputs.items():
            if output.get('current_mode') is None:
                continue
            row = Gtk.Box(spacing=16)
            row.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            combo = Gtk.ComboBoxText()
            for scale in ('1.0', '1.25', '1.5', '1.75', '2.0'):
                combo.append(scale, f'{float(scale)*100:g}%')
            current = output.get('logical', {}).get('scale', 1.25)
            combo.set_active_id(str(current))
            if combo.get_active_id() is None:
                combo.append(str(current), f'{current*100:g}%');combo.set_active_id(str(current))
            row.pack_end(combo, False, False, 0)
            modes = Gtk.ComboBoxText()
            for index, mode in enumerate(output['modes']):
                value = f"{mode['width']}x{mode['height']}@{mode['refresh_rate']/1000:g}"
                modes.append(str(index), value)
            modes.set_active_id(str(output['current_mode']))
            row.pack_start(modes, False, False, 0)
            logical = output.get('logical') or {}
            x = Gtk.SpinButton.new_with_range(-16384, 16384, 1)
            y = Gtk.SpinButton.new_with_range(-16384, 16384, 1)
            x.set_value(logical.get('x', 0));y.set_value(logical.get('y', 0))
            row.pack_start(Gtk.Label(label='X'), False, False, 0);row.pack_start(x, False, False, 0)
            row.pack_start(Gtk.Label(label='Y'), False, False, 0);row.pack_start(y, False, False, 0)
            self.rows.append((name, combo, modes, x, y));box.pack_start(row, False, False, 0)
        box.pack_start(Gtk.Label(label='Resolution · scale · logical X/Y position. Changes revert after 15 seconds unless kept.',
                                xalign=0, wrap=True), False, False, 0)
        self.status = Gtk.Label(xalign=0);self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)
        self.keep = Gtk.Button(label='Keep display settings');self.keep.set_sensitive(False)
        self.keep.connect('clicked', self.save);box.pack_end(self.keep, False, False, 0)
        self.apply_button = Gtk.Button(label='Test display settings (15 seconds)')
        self.apply_button.connect('clicked', self.apply);box.pack_end(self.apply_button, False, False, 0)

    def set_output(self, name, mode, scale, x, y):
        for action in [('mode', mode), ('scale', str(scale)), ('position', 'set', '--', str(x), str(y))]:
            subprocess.run(['niri', 'msg', 'output', name, *action], check=True, capture_output=True, timeout=5)

    def mode(self, output, index):
        mode = output['modes'][index]
        return f"{mode['width']}x{mode['height']}@{mode['refresh_rate']/1000:g}"

    def apply(self, _button):
        try:
            self.previous = json.loads(subprocess.check_output(['niri', 'msg', '--json', 'outputs'], text=True))
            self.pending = '// Generated by Rova Display Settings.\n'
            self.apply_button.set_sensitive(False)
            self.countdown = 15
            self.timer = GLib.timeout_add_seconds(1, self.tick)
            for name, combo, modes, x, y in self.rows:
                scale = float(combo.get_active_id())
                mode = self.mode(self.outputs[name], int(modes.get_active_id()))
                self.set_output(name, mode, scale, x.get_value_as_int(), y.get_value_as_int())
                self.pending += (f'output {json.dumps(name)} {{ scale {scale}; mode {json.dumps(mode)}; '
                                 f'position x={x.get_value_as_int()} y={y.get_value_as_int()}; }}\n')
            self.keep.set_sensitive(True)
            self.status.set_text('Keep these settings? Reverting in 15 seconds.')
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.revert()
            self.status.set_text(f'Could not apply display settings: {error}')

    def tick(self):
        self.countdown -= 1
        if self.countdown <= 0:
            self.timer = None
            self.revert()
            return False
        self.status.set_text(f'Keep these settings? Reverting in {self.countdown} seconds.')
        return True

    def revert(self):
        if self.timer:
            GLib.source_remove(self.timer);self.timer = None
        if self.previous:
            for name, output in self.previous.items():
                if output.get('current_mode') is not None:
                    logical = output.get('logical') or {}
                    try:
                        self.set_output(name, self.mode(output, output['current_mode']),
                                        logical.get('scale', 1), logical.get('x', 0), logical.get('y', 0))
                    except (OSError, subprocess.SubprocessError):
                        pass  # Disconnected outputs cannot be restored until reconnected.
        self.previous = None
        self.keep.set_sensitive(False);self.apply_button.set_sensitive(True)
        self.status.set_text('Previous display settings restored where outputs are still connected.')

    def save(self, _button):
        try:
            config = pathlib.Path.home()/'.config/niri/outputs.kdl'
            config.parent.mkdir(parents=True, exist_ok=True)
            temporary = config.with_suffix('.kdl.tmp');temporary.write_text(self.pending);temporary.replace(config)
            if self.timer:
                GLib.source_remove(self.timer);self.timer = None
            self.previous = None
            self.keep.set_sensitive(False);self.apply_button.set_sensitive(True)
            self.status.set_text('Saved. Retained after restart only when USB saving is enabled.')
        except OSError as error:
            self.revert();self.status.set_text(f'Could not save display settings: {error}')

    def closing(self, *_args):
        if self.previous:
            self.revert()
        return False


window = Displays();window.show_all();Gtk.main()
